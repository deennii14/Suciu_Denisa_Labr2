@page "{id:int?}"
@model Suciu_Denisa_Labr2.Pages.Categories.IndexModel

@{
    ViewData["Title"] = "Categories";
}

<h1>Categories</h1>

<p>
    <a asp-page="Create">Create New</a>
</p>

<table class="table">
    <thead>
        <tr>
            <th>Category Name</th>
            <th></th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model.CategoryData.Categories)
        {
            string selectedRow = "";
            if (item.ID == Model.CategoryID)
            {
                selectedRow = "table-success";
            }
            <tr class="@selectedRow">
                <td>@item.CategoryName</td>
                <td>
                    <a asp-page="./Index" asp-route-id="@item.ID">Select</a> |
                    <a asp-page="./Edit" asp-route-id="@item.ID">Edit</a> |
                    <a asp-page="./Details" asp-route-id="@item.ID">Details</a> |
                    <a asp-page="./Delete" asp-route-id="@item.ID">Delete</a>
                </td>
            </tr>
        }
    </tbody>
</table>

@if (Model.CategoryData.Books != null)
{
    <h3>Books in Selected Category</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Title</th>
                <th>Author</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.CategoryData.Books)
            {
                <tr>
                    <td>@book.Title</td>
                    <td>@book.Author.FullName</td>
                </tr>
            }
        </tbody>
    </table>

    <h3>Borrowings for Books in This Category</h3>

    <table class="table">
        <thead>
            <tr>
                <th>Member</th>
                <th>Book</th>
                <th>Author</th>
                <th>Return Date</th>
                <th></th>
            </tr>
        </thead>
        <tbody>
            @foreach (var book in Model.CategoryData.Books)
            {
                if (book.Borrowings != null)
                {
                    foreach (var borrowing in book.Borrowings)
                    {
                        <tr>
                            <td>@borrowing.Member.FullName</td>
                            <td>@borrowing.Book.Title</td>
                            <td>@borrowing.Book.Author.FullName</td>
                            <td>@borrowing.ReturnDate.ToShortDateString()</td>
                            <td>
                                <a asp-page="/Borrowings/Edit" asp-route-id="@borrowing.ID">Edit</a> |
                                <a asp-page="/Borrowings/Details" asp-route-id="@borrowing.ID">Details</a> |
                                <a asp-page="/Borrowings/Delete" asp-route-id="@borrowing.ID">Delete</a>
                            </td>
                        </tr>
                    }
                }
            }
        </tbody>
    </table>
}
